{
  "name": "handoff-io-cli",
  "version": "1.0.11",
  "type": "module",
  "description": "Automated project delivery and client handoff engine",
  "main": "dist/index.js",
  "bin": {
    "handoff": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsx bin/index.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@google/generative-ai": "^0.24.1",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "gradient-string": "^3.0.0",
    "ignore": "^7.0.6",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "simple-git": "^3.36.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tree-sitter": "$tree-sitter"
  }
}
